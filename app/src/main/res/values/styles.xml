<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FacesGallery.Base" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3057D5</item>
        <item name="android:windowBackground">#F7F8FC</item>
        <item name="android:statusBarColor">#F7F8FC</item>
        <item name="android:navigationBarColor">#F7F8FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/Theme.FacesGallery.Dialog</item>
    </style>

    <style name="Theme.FacesGallery.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#3057D5</item>
        <item name="android:buttonBarButtonStyle">@style/FacesGallery.DialogButton</item>
    </style>

    <style name="FacesGallery.DialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.FacesGallery" parent="Theme.FacesGallery.Base" />
</resources>
